# AI Job Hunter - Environment Variables
# Copy this file to .env and fill in your values

# --- AI Provider (choose one) ---

# Option 1: Agnes AI (preferred, free tier available)
AGNES_API_KEY=
AGNES_BASE_URL=https://apihub.agnes-ai.com/v1

# Option 2: Google Gemini (free tier: 1500 requests/day)
GEMINI_API_KEY=

# Option 3: NVIDIA NIM (free tier available)
AI_API_KEY=
AI_BASE_URL=https://integrate.api.nvidia.com/v1
AI_MODEL=meta/llama-3.1-70b-instruct

# --- Search Settings ---
# SEARCH_KEYWORDS="Data Analyst,RPA Developer,Python Developer"
# LOCATIONS="Penang, Malaysia,Kuala Lumpur, Malaysia"
# MATCH_THRESHOLD=80

# --- Email Notifications (optional) ---
# EMAIL_SENDER=your_email@gmail.com
# EMAIL_PASSWORD=your_app_password
# EMAIL_RECEIVER=destination@email.com

# --- Telegram Notifications (optional) ---
# TELEGRAM_BOT_TOKEN=bot123456:ABC-DEF...
# TELEGRAM_CHAT_ID=123456789

# --- Dashboard Access Token (optional, recommended) ---
# If set, every API call to the dashboard must include this token
# (the browser will ask for it once). Protects your personal job data on LAN.
# DASHBOARD_TOKEN=change-me-to-a-long-random-string
